<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#87ACF8"
    android:id="@+id/main">

    <TextView
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="139dp"
        android:layout_marginBottom="592dp"
        android:fontFamily="@font/npsfont_regular"
        android:text="당신의 학습의 경각심을 불러일으키다!"
        android:textColor="@color/white"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text2"
        android:layout_width="113dp"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:text="공각심"
        android:textSize="36dp"
        android:fontFamily="@font/npsfont_regular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="13dp"
        app:layout_constraintTop_toBottomOf="@+id/text1">
    </TextView>

    <ImageView
        android:layout_width="121dp"
        android:layout_height="138dp"
        android:src="@drawable/in_app_icon"
        app:layout_constraintTop_toBottomOf="@id/text2"
        app:layout_constraintStart_toStartOf="@id/text2"
        app:layout_constraintEnd_toEndOf="@id/text2"
        android:layout_marginStart="7dp"
        android:layout_marginTop="30dp"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/old_user_btn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#BFD5FF"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/new_user_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="90dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="이메일로 로그인"
            android:textSize="13sp"
            android:fontFamily="@font/npsfont_regular"
            android:textColor="#000000"/>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/new_user_btn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#FFFFFF"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="58dp"
        app:layout_constraintBottom_toTopOf="@id/forgottenbtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="90dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="회원가입"
            android:textSize="13sp"
            android:fontFamily="@font/npsfont_regular"
            android:textColor="#000000"/>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/forgottenbtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:fontFamily="@font/npsfont_regular"
        android:text="최근 로그인 계정이 기억이 나지 않아요!"
        android:textColor="@color/white"
        android:textSize="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>