<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_calender_day_item"
    android:orientation="vertical"
    android:gravity="center">

    <ImageView
        android:id="@+id/item_line_right_12"
        android:layout_width="0dp"
        android:layout_height="25dp"
        android:background="@drawable/task_line_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/fragment_calender_dayTv"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        />

    <ImageView
        android:id="@+id/item_line_mid_12"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:background="@drawable/task_line_mid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        />


    <ImageView
        android:id="@+id/item_line_left_12"
        android:layout_width="0dp"
        android:layout_height="25dp"
        android:background="@drawable/task_line_end"
        app:layout_constraintEnd_toEndOf="@id/fragment_calender_dayTv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        />

    <ImageView
        android:id="@+id/item_line_12"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:background="@drawable/task_line_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        />

    <TextView
        android:id="@+id/fragment_calender_dayTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="5dp"
        android:text="0"
        android:textSize="12sp"
        android:fontFamily="@font/npsfont_regular"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>